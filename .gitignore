.env
config/runtime.env
# Anchored with a leading slash: these are the runtime directories at the repository
# root. Unanchored, `data/` also matched `docs/data/`, which kept DATA_MODEL.md out of
# version control entirely.
/data/
/models/
*.wav
*.flac
*.sqlite
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/

# Model assets are never committed (ADR-006): their licences differ from this
# code's and acquisition is a deliberate, attributable operator step.
/models/*.tflite
/models/*.txt
!/models/manifest.tsv

# scripts/benchmark_batdetect2.py --json writes here. Bulk/ad-hoc benchmark
# output is not committed, but results/batdetect2-pi5.json is a deliberate
# exception: it is the provenance record Milestone 5's BatDetect2 exit gate
# cites (see docs/detectors/BATDETECT2_EVALUATION.md). Anyone re-running that
# benchmark should `git add -f` that one file over the top of this ignore
# rule and commit it -- everything else under results/ stays untracked.
/results/*
!/results/batdetect2-pi5.json

# Build output
*.egg-info/
web/dist/
tsbuildinfo
*.tsbuildinfo

# Local virtualenvs and agent worktrees
.venv/
venv/
.claude/worktrees/
