.env
config/runtime.env
# Anchored with a leading slash: these are the runtime directories at the repository
# root. Unanchored, `data/` also matched `docs/data/`, which kept DATA_MODEL.md out of
# version control entirely.
/data/
/models/
*.wav
*.flac
*.sqlite
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/

# Model assets are never committed (ADR-006): their licences differ from this
# code's and acquisition is a deliberate, attributable operator step.
/models/*.tflite
/models/*.txt
!/models/manifest.tsv

# Build output
*.egg-info/
web/dist/
tsbuildinfo
*.tsbuildinfo

# Local virtualenvs and agent worktrees
.venv/
venv/
.claude/worktrees/
