# Example configuration. Copy to config/runtime.env on the station and edit.
#
# config/runtime.env is deliberately NOT in version control and is excluded from
# the deploy script's rsync --delete. It is operator-owned state.
#
# Every key is optional: these are the defaults from src/open_observatory/config.py.
# This file is a curated subset of the settings an operator usually touches, not
# the full list -- config.py is the complete, commented reference and there are
# well over a hundred fields there (detector thresholds, retention tiers, clip
# budgets, spectrogram ranges, the ultrasonic band and schedule, and more).
#
# Settings ignores unknown OO_* keys, so a misspelled name fails silently rather
# than loudly. Check `oo config` after editing: it prints the effective
# configuration, including the resolved database DSN. Every key below was
# verified against a real Settings field on 2026-08-09.
#
# KNOWN BUG, found while adding the auth settings below: pydantic-settings
# tries to JSON-decode a tuple-typed field's raw env/dotenv value before this
# file's plain comma-separated form is ever parsed, so actually SETTING (not
# just leaving at its default) OO_PREFERRED_SAMPLE_RATES, OO_PREFERRED_FORMATS
# or OO_CLIP_PLUGINS from this file raises a SettingsError at startup and the
# station will not come up at all. Pre-existing, not introduced here, and not
# fixed here (outside this change's territory) -- if this file is copied
# verbatim rather than edited, those three lines are the ones to comment out
# or remove first. OO_AUTH_PUBLIC_READ_PATHS below does not have this problem.

OO_STATION_NAME=Garden Observatory
OO_TIMEZONE=Europe/London
OO_LATITUDE=
OO_LONGITUDE=

# Device selection is by stable device key (USB vendor:product:serial) or an ALSA
# card id -- never a card number, which changes across reboots. Leave unset to let
# `oo audio probe` resolve the device. Run `oo audio probe` to see the real key.
OO_AUDIO_DEVICE=
OO_PREFERRED_SAMPLE_RATES=384000,250000,192000,96000,48000
OO_NATIVE_RING_SECONDS=120
OO_CLIP_RETENTION_DAYS=30

OO_BIND_HOST=0.0.0.0
OO_BIND_PORT=8080

# Empty means the SQLite developer default under data/ (ADR-007). A PostgreSQL DSN
# is the production target. An Alembic migration environment now exists (ADR-035,
# three revisions), so the prerequisite this comment used to name is met -- but it
# has only ever been exercised against SQLite, so the swap is untested rather than
# impossible. See docs/data/DATA_MODEL.md, "Migrations".
OO_DATABASE_DSN=

# MQTT / Home Assistant (Milestone 6, ADR-025 -- this line previously cited
# ADR-022, which is about live ultrasonic retuning and has nothing to do with
# MQTT). Off by default. Set
# OO_MQTT_ENABLED=true and the broker details below, then restart, to publish
# station state and detections with Home Assistant MQTT Discovery. Credentials
# belong here, never in version control -- this file is gitignored. See
# docs/operations/HOME_ASSISTANT.md for the full setup and verification steps.
OO_MQTT_ENABLED=false
OO_MQTT_HOST=localhost
OO_MQTT_PORT=1883
OO_MQTT_TLS=false
OO_MQTT_TLS_INSECURE=false
OO_MQTT_USERNAME=
OO_MQTT_PASSWORD=
OO_MQTT_CLIENT_ID=open-observatory
OO_MQTT_TOPIC_PREFIX=openobservatory
OO_MQTT_DISCOVERY_PREFIX=homeassistant

# Authentication (Milestone 4, ADR-034, closes ADR-015). Off by default -- an
# upgrade changes nothing until this is set. Turning it on creates a
# 'operator' account on next startup with a random password PRINTED ONCE to
# the service's stdout/journal; it is never written to this file or any file
# in this repository. See docs/operations/DEPLOYMENT_AND_OPERATIONS.md's
# "Authentication" section before enabling this on a station with the ESP32
# inside-observer display attached.
OO_AUTH_ENABLED=false
OO_AUTH_BOOTSTRAP_USERNAME=operator
# GET-only paths reachable with no credential even when auth is on. Default
# covers the ESP32 display's detections poll; /api/v1/health and /metrics are
# always public regardless of this list (deploy.sh's health check and a
# Prometheus scraper have no login flow either). Safe to override from the
# environment (comma-separated), unlike the pre-existing tuple-typed
# settings noted below.
OO_AUTH_PUBLIC_READ_PATHS=/api/v1/detections
# Only set true once a reverse proxy or similar terminates TLS in front of
# this station -- this codebase has no TLS component, and a Secure cookie on
# a plain-HTTP origin is silently never sent back by the browser, which
# breaks login rather than securing it. See ADR-034.
OO_AUTH_COOKIE_SECURE=false
