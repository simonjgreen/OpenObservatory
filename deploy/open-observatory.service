# Template unit (ADR-047): @DEPLOY_USER@ and @DEPLOY_ROOT@ are substituted by
# deploy/deploy.sh at install time with the deploy user and the synced tree's
# path. Installing this file verbatim will not start; there is deliberately no
# committed default user or path.
[Unit]
Description=Open Observatory station (capture, detectors, API, debug UI)
Documentation=file://@DEPLOY_ROOT@/docs/operations/DEPLOYMENT_AND_OPERATIONS.md
After=network-online.target sound.target time-sync.target
Wants=network-online.target
# ADR-063. A Raspberry Pi has no battery-backed RTC: it boots with the
# timestamp systemd saved at last shutdown and NTP steps the clock forward once
# the network is up. On 2026-08-17 capture opened 1 minute 45 seconds before
# that step and anchored its frame-to-UTC mapping to the pre-sync clock, so
# every detection, clip filename and spectrogram column for the following 49
# hours carried a UTC time 106 seconds early.
#
# `time-sync.target` is ordering only and is reached by systemd-timesyncd
# *before* it has actually synchronised, so this is a cheap improvement rather
# than a guarantee -- the guarantee is `Station._reanchor_clock_if_stepped`,
# which corrects a step whenever it happens, including mid-run. Making this a
# hard dependency (`systemd-time-wait-sync.service`) is deliberately **not**
# done: it would block capture indefinitely on a station with no network, and
# recording with an imperfect clock beats not recording at all.

[Service]
Type=exec
User=@DEPLOY_USER@
Group=@DEPLOY_USER@
# Capture needs the audio group for /dev/snd, and hidraw access for AudioMoth
# configuration reads. Nothing here needs root.
SupplementaryGroups=audio plugdev
WorkingDirectory=@DEPLOY_ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@DEPLOY_ROOT@/config/runtime.env
ExecStart=@DEPLOY_ROOT@/.venv/bin/oo serve

Restart=always
RestartSec=5
# The capture thread must not be starved by detector inference. A modest
# real-time-ish priority is enough; full SCHED_FIFO is not needed and would risk
# locking up the box if capture ever spun.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

# Bounded logging: this station is expected to run for months.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=open-observatory

# Privilege reduction (technical spec §13). The service needs its own directory,
# /dev/snd and the network; nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@DEPLOY_ROOT@/data
# config/, because ADR-048 made settings web-editable and they persist to
# config/runtime.env. Without this the API accepts a settings change, validates
# it, and then dies with `OSError: [Errno 30] Read-only file system` inside the
# atomic write -- a 500 with the whole feature dead in production while every
# test passes locally, where no such protection applies. Found 2026-08-09 by
# trying to change a detector threshold on the live station.
#
# Only config/, not @DEPLOY_ROOT@: the source tree stays read-only to the
# service, which is the point of ProtectHome.
ReadWritePaths=@DEPLOY_ROOT@/config
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=false
MemoryMax=6G

[Install]
WantedBy=multi-user.target
